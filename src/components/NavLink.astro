---
import type { NavLink } from '~/types'

interface Props {
  link: NavLink
}

const { link } = Astro.props

// Los links externos se dejan tal cual. Los internos necesitan el prefijo
// de base (import.meta.env.BASE_URL) para funcionar cuando el sitio vive
// bajo un subpath, como en GitHub Pages (ej: /unsuario2_website).
// Este tema usa trailingSlash: 'never', así que NUNCA debe quedar una barra
// al final -- ni siquiera para la home, que en un sitio con base es
// simplemente el base a secas (ej: /unsuario2_website, no /unsuario2_website/).
const baseNoSlash = import.meta.env.BASE_URL.replace(/\/$/, '')
const relativePath = link.url.replace(/^\//, '').replace(/\/$/, '')
const href = link.external
  ? link.url
  : relativePath
    ? `${baseNoSlash}/${relativePath}`
    : baseNoSlash || '/'
---

<a
  class="underline"
  rel={link.external ? 'noopener noreferrer' : undefined}
  target={link.external ? '_blank' : undefined}
  href={href}
>
  {link.name}
</a>
